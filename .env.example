# Copie ce fichier en .env.local et renseigne les valeurs.
# Sur Vercel, ces variables se règlent dans Settings > Environment Variables
# (Neon et Blob les ajoutent automatiquement quand tu les relies au projet via l'onglet Storage).

# Base Postgres (Neon). Utilise l'URL "pooled" fournie par Neon.
# En local : postgres://utilisateur:motdepasse@localhost:5432/vertical
DATABASE_URL=

# Vercel Blob (store en accès public : Instagram doit pouvoir télécharger la vidéo).
# Sur Vercel, relier le store au projet suffit : @vercel/blob utilise ce token ou, à défaut,
# l'authentification OIDC de Vercel avec BLOB_STORE_ID (ajoutée automatiquement).
# En local, si vide, les fichiers sont enregistrés dans .data/files.
BLOB_READ_WRITE_TOKEN=

# Sons YouTube : cookies d'un compte YouTube SECONDAIRE (format Netscape « cookies.txt »).
# Sans eux, YouTube bloque le téléchargement depuis les serveurs Vercel (« not a bot »).
# Colle le contenu du fichier tel quel, ou encodé en base64. Voir README, section « Sons YouTube ».
YOUTUBE_COOKIES=

# Mot de passe du site (obligatoire sur Vercel : sans lui, tout le site reste fermé).
# Choisis un mot de passe long (4 mots au hasard, par exemple). Le changer déconnecte tous les appareils.
# En local, si vide, le site est ouvert sans connexion.
APP_PASSWORD=

# Secret des tâches planifiées (étape 4) : elles envoient « Authorization: Bearer <CRON_SECRET> ».
# Une longue chaîne aléatoire (ex. : openssl rand -hex 32). Facultatif tant qu'il n'y a pas de tâche.
CRON_SECRET=
